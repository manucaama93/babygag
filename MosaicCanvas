package com.manucaama.babygagphone

import android.content.Context
import android.content.res.Resources
import android.graphics.Bitmap
import android.graphics.BitmapFactory
import android.graphics.Canvas
import android.graphics.Color
import android.graphics.Matrix
import android.graphics.Paint
import android.graphics.Rect
import android.graphics.RectF
import android.util.AttributeSet
import android.view.GestureDetector
import android.view.MotionEvent
import android.view.ScaleGestureDetector
import android.view.View
import kotlinx.coroutines.CoroutineScope
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.SupervisorJob
import kotlinx.coroutines.launch
import kotlinx.coroutines.withContext

class MosaicCanvasView @JvmOverloads constructor(
    context: Context,
    attrs: AttributeSet? = null,
    defStyleAttr: Int = 0
) : View(context, attrs, defStyleAttr),
    ScaleGestureDetector.OnScaleGestureListener,
    GestureDetector.OnGestureListener {

    private val totalCols = 30
    private val totalRows = 60
    private val totalItems = totalCols * totalRows

    private val centerRow = totalRows / 2
    private val centerCol = (totalCols / 2) - 1

    private val bebeNegroIndex = centerRow * totalCols + centerCol
    private val bebeBlancoIndex = centerRow * totalCols + (centerCol + 1)

    private val matrix = Matrix()
    private val matrixValues = FloatArray(9)
    private var scaleFactor = 1.0f
    private var minScale = 1.0f
    private var maxScale = 10.0f

    private val scaleDetector = ScaleGestureDetector(context, this)
    private val gestureDetector = GestureDetector(context, this)

    private val paint = Paint(Paint.ANTI_ALIAS_FLAG or Paint.FILTER_BITMAP_FLAG)
    private val overlayPaint = Paint(Paint.ANTI_ALIAS_FLAG)

    private val dstRect = RectF()
    private val srcRect = Rect()

    private val bitmapBebeNegro: Bitmap? = BitmapFactory.decodeResource(resources, R.drawable.bebe_negro)
    private val bitmapBebeBlanco: Bitmap? = BitmapFactory.decodeResource(resources, R.drawable.bebe_blanco)

    // Lista procesada con las fotos de la galería y sus colores medios
    private val processedMosaicPhotos = mutableListOf<MosaicPhoto>()

    // Arrays para guardar el índice de la foto y el color objetivo de cada celda
    private val cellPhotoIndices = IntArray(totalItems)
    private val cellTargetColors = IntArray(totalItems)

    private var initialSetupDone = false

    // Ámbito de corrutinas para esta Vista
    private val viewScope = CoroutineScope(Dispatchers.Default + SupervisorJob())
    private val mosaicEngine = MosaicEngine()

    init {
        setLayerType(LAYER_TYPE_HARDWARE, null)
        loadGalleryAndBuildMosaic()
    }

    private fun loadGalleryAndBuildMosaic() {
        viewScope.launch {
            val rawBitmaps = mutableListOf<Bitmap>()
            var i = 1

            // 1. Cargar las imágenes dinámicamente desde res/drawable
            while (true) {
                val resId = context.resources.getIdentifier("imagen_$i", "drawable", context.packageName)
                if (resId == 0) break

                val bmp = decodeSampledBitmapFromResource(resources, resId, 120, 120)
                if (bmp != null) {
                    rawBitmaps.add(bmp)
                }
                i++
            }

            // 2. Preprocesar los colores medios de la galería
            val processedList = rawBitmaps.map { bmp ->
                val (r, g, b) = mosaicEngine.calculateAverageColor(bmp)
                MosaicPhoto(bitmap = bmp, averageRed = r, averageGreen = g, averageBlue = b)
            }

            withContext(Dispatchers.Main) {
                processedMosaicPhotos.clear()
                processedMosaicPhotos.addAll(processedList)

                // 3. Generar el fotomosaico real imitando a 'famoso_1'
                if (processedMosaicPhotos.isNotEmpty()) {
                    val bitmapObjetivo = BitmapFactory.decodeResource(resources, R.drawable.famoso_1)
                    if (bitmapObjetivo != null) {
                        generateTrueMosaic(bitmapObjetivo)
                    }
                }
            }
        }
    }

    fun generateTrueMosaic(targetBitmap: Bitmap) {
        if (processedMosaicPhotos.isEmpty()) return

        viewScope.launch {
            val newIndices = IntArray(totalItems)
            val newColors = IntArray(totalItems)
            val tw = targetBitmap.width
            val th = targetBitmap.height

            for (i in 0 until totalItems) {
                val row = i / totalCols
                val col = i % totalCols

                val startX = (col * tw) / totalCols
                val endX = ((col + 1) * tw) / totalCols
                val startY = (row * th) / totalRows
                val endY = ((row + 1) * th) / totalRows

                var rSum = 0
                var gSum = 0
                var bSum = 0
                var count = 0

                val stepX = maxOf(1, (endX - startX) / 8)
                val stepY = maxOf(1, (endY - startY) / 8)

                for (x in startX until endX step stepX) {
                    for (y in startY until endY step stepY) {
                        if (x < tw && y < th) {
                            val pixel = targetBitmap.getPixel(x, y)
                            rSum += Color.red(pixel)
                            gSum += Color.green(pixel)
                            bSum += Color.blue(pixel)
                            count++
                        }
                    }
                }

                val cellR = if (count > 0) rSum / count else 0
                val cellG = if (count > 0) gSum / count else 0
                val cellB = if (count > 0) bSum / count else 0

                newColors[i] = Color.rgb(cellR, cellG, cellB)

                val bestMatchPhoto = mosaicEngine.findBestMatchingPhoto(cellR, cellG, cellB, processedMosaicPhotos)
                val bestIndex = processedMosaicPhotos.indexOf(bestMatchPhoto)

                newIndices[i] = if (bestIndex != -1) bestIndex else 0
            }

            withContext(Dispatchers.Main) {
                System.arraycopy(newIndices, 0, cellPhotoIndices, 0, totalItems)
                System.arraycopy(newColors, 0, cellTargetColors, 0, totalItems)
                invalidate()
            }
        }
    }

    private fun decodeSampledBitmapFromResource(res: Resources, resId: Int, reqWidth: Int, reqHeight: Int): Bitmap {
        return BitmapFactory.Options().run {
            inJustDecodeBounds = true
            BitmapFactory.decodeResource(res, resId, this)

            inSampleSize = calculateInSampleSize(this, reqWidth, reqHeight)

            inJustDecodeBounds = false
            inPreferredConfig = Bitmap.Config.RGB_565
            BitmapFactory.decodeResource(res, resId, this)
        }
    }

    private fun calculateInSampleSize(options: BitmapFactory.Options, reqWidth: Int, reqHeight: Int): Int {
        val (height: Int, width: Int) = options.outHeight to options.outWidth
        var inSampleSize = 1

        if (height > reqHeight || width > reqWidth) {
            val halfHeight: Int = height / 2
            val halfWidth: Int = width / 2
            while (halfHeight / inSampleSize >= reqHeight && halfWidth / inSampleSize >= reqWidth) {
                inSampleSize *= 2
            }
        }
        return inSampleSize
    }

    override fun performClick(): Boolean {
        super.performClick()
        return true
    }

    override fun onTouchEvent(event: MotionEvent): Boolean {
        if (event.action == MotionEvent.ACTION_UP) {
            performClick()
        }
        var handled = scaleDetector.onTouchEvent(event)
        handled = gestureDetector.onTouchEvent(event) || handled
        return handled || super.onTouchEvent(event)
    }

    override fun onSizeChanged(w: Int, h: Int, oldw: Int, oldh: Int) {
        super.onSizeChanged(w, h, oldw, oldh)
        if (!initialSetupDone && w > 0 && h > 0) {
            setupInitialFocusOnCenter()
            initialSetupDone = true
        }
    }

    private fun setupInitialFocusOnCenter() {
        val baseCellWidth = width / totalCols.toFloat()
        val cellWidthNear = width / 3f

        minScale = 1.0f
        maxScale = cellWidthNear / baseCellWidth

        scaleFactor = maxScale
        matrix.reset()

        matrix.postScale(scaleFactor, scaleFactor, 0f, 0f)

        val translateX = (width / 2f) - ((centerCol + 0.5f) * baseCellWidth * scaleFactor)

        val bottomMarginPx = 84f * resources.displayMetrics.density
        val centerCellTopScaled = (centerRow * baseCellWidth) * scaleFactor
        val targetYInScreen = height - bottomMarginPx - cellWidthNear
        val translateY = targetYInScreen - centerCellTopScaled

        matrix.postTranslate(translateX, translateY)
        clampMatrixBounds()
        invalidate()
    }

    override fun onDraw(canvas: Canvas) {
        super.onDraw(canvas)
        canvas.save()
        canvas.concat(matrix)

        canvas.drawColor(Color.WHITE)

        val fixedScreenGapPx = 2.5f
        val effectiveGap = fixedScreenGapPx / scaleFactor
        val baseCellWidth = width / totalCols.toFloat()

        for (i in 0 until totalItems) {
            val row = i / totalCols
            val col = i % totalCols

            val left = col * baseCellWidth + (effectiveGap / 2f)
            val top = row * baseCellWidth + (effectiveGap / 2f)
            val right = (col + 1) * baseCellWidth - (effectiveGap / 2f)
            val bottom = (row + 1) * baseCellWidth - (effectiveGap / 2f)

            dstRect.set(left, top, right, bottom)

            when (i) {
                bebeNegroIndex -> {
                    if (bitmapBebeNegro != null) {
                        drawBitmapCenterCrop(canvas, bitmapBebeNegro, dstRect)
                    } else {
                        paint.color = Color.BLACK
                        canvas.drawRect(dstRect, paint)
                    }
                }
                bebeBlancoIndex -> {
                    if (bitmapBebeBlanco != null) {
                        drawBitmapCenterCrop(canvas, bitmapBebeBlanco, dstRect)
                    } else {
                        paint.color = Color.GRAY
                        canvas.drawRect(dstRect, paint)
                    }
                }
                else -> {
                    if (processedMosaicPhotos.isNotEmpty()) {
                        val photoIndex = cellPhotoIndices[i]
                        // 1. Dibujar la miniatura de la galería
                        drawBitmapCenterCrop(canvas, processedMosaicPhotos[photoIndex].bitmap, dstRect)

                        // 2. Aplicar el velo de fusión respetando la transparencia
                        overlayPaint.color = cellTargetColors[i]
                        overlayPaint.alpha = 50
                        canvas.drawRect(dstRect, overlayPaint)
                    } else {
                        paint.color = Color.LTGRAY
                        canvas.drawRect(dstRect, paint)
                    }
                }
            }
        }

        canvas.restore()
    }

    private fun drawBitmapCenterCrop(canvas: Canvas, bitmap: Bitmap, dst: RectF) {
        val bw = bitmap.width
        val bh = bitmap.height

        val srcLeft: Int
        val srcTop: Int
        val srcRight: Int
        val srcBottom: Int

        if (bw > bh) {
            srcLeft = (bw - bh) / 2
            srcTop = 0
            srcRight = srcLeft + bh
            srcBottom = bh
        } else {
            srcLeft = 0
            srcTop = (bh - bw) / 2
            srcRight = bw
            srcBottom = srcTop + bw
        }

        srcRect.set(srcLeft, srcTop, srcRight, srcBottom)
        canvas.drawBitmap(bitmap, srcRect, dst, paint)
    }

    private fun clampMatrixBounds() {
        matrix.getValues(matrixValues)
        val currentScale = matrixValues[Matrix.MSCALE_X]
        val transY = matrixValues[Matrix.MTRANS_Y]

        val bottomMarginPx = 84f * resources.displayMetrics.density
        val baseCellWidth = width / totalCols.toFloat()
        val totalGridHeight = (totalRows * baseCellWidth) * currentScale
        val availableHeight = height - bottomMarginPx

        val clampedX = (width / 2f) - ((centerCol + 0.5f) * baseCellWidth * currentScale)

        val clampedY = if (totalGridHeight <= availableHeight) {
            0f
        } else {
            val minTransY = availableHeight - totalGridHeight
            val maxTransY = 0f
            transY.coerceIn(minTransY, maxTransY)
        }

        matrixValues[Matrix.MTRANS_X] = clampedX
        matrixValues[Matrix.MTRANS_Y] = clampedY
        matrix.setValues(matrixValues)
    }

    override fun onScale(detector: ScaleGestureDetector): Boolean {
        val oldScale = scaleFactor
        scaleFactor *= detector.scaleFactor
        scaleFactor = scaleFactor.coerceIn(minScale, maxScale)

        if (oldScale != 0f) {
            val factor = scaleFactor / oldScale
            matrix.postScale(factor, factor, detector.focusX, detector.focusY)
            clampMatrixBounds()
            invalidate()
        }
        return true
    }

    override fun onScroll(e1: MotionEvent?, e2: MotionEvent, dX: Float, dY: Float): Boolean {
        val filteredDX = 0f
        val filteredDY = dY

        matrix.postTranslate(-filteredDX, -filteredDY)
        clampMatrixBounds()
        invalidate()
        return true
    }

    override fun onScaleBegin(detector: ScaleGestureDetector): Boolean = true
    override fun onScaleEnd(detector: ScaleGestureDetector) {}
    override fun onDown(e: MotionEvent): Boolean = true
    override fun onShowPress(e: MotionEvent) {}
    override fun onSingleTapUp(e: MotionEvent): Boolean = false
    override fun onLongPress(e: MotionEvent) {}
    override fun onFling(e1: MotionEvent?, e2: MotionEvent, vX: Float, vY: Float): Boolean = false
}
